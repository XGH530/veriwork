# OpenAI-compatible endpoint
LLM_API_URL=https://your-provider.example/v1/chat/completions
LLM_API_KEY=replace-with-your-key
LLM_MODEL=model-name

HOST=127.0.0.1
PORT=8000

# Store the SQLite database outside the web application directory in production.
VERIWORK_DB_PATH=/opt/veriwork-data/veriwork.db
VERIWORK_EVIDENCE_DIR=/opt/veriwork-data/evidence
MAX_EVIDENCE_BYTES=8388608

# First startup requires a strong administrator password (at least 10 characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional legacy/demo account. Leave blank to disable automatic synchronization.
DEMO_USERNAME=demo
DEMO_PASSWORD=

# Cookie scope behind the /veriwork/ reverse proxy. Use 1 after HTTPS is enabled.
SESSION_COOKIE_PATH=/veriwork/
SESSION_COOKIE_SECURE=0

# Only set this for a separate browser frontend origin. Same-origin deployments leave it blank.
CORS_ORIGIN=
